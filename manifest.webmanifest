{
  "name": "KeyChanger",
  "short_name": "KeyChanger",
  "description": "Zet akkoorden in een andere toonsoort en bekijk je bladmuziek met ReadSheet.",
  "lang": "nl",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0a2a6b",
  "theme_color": "#0b5ed7",
  "icons": [
    { "src": "./icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./apple-touch-icon.png", "sizes": "180x180", "type": "image/png" }
  ],
  "share_target": {
    "action": "./?share-target=1",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "files", "accept": ["application/pdf", ".pdf", "image/*"] }
      ]
    }
  }
}
